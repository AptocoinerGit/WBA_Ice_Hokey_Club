	partition DimDate = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( Buchungen[Buchungsdatum] ),
				        MAX ( Buchungen[Buchungsdatum] )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMMM" ),
				    "Day", DAY ( [Date] ),
				    "Day Name", FORMAT ( [Date], "dddd" )
				)
				
				```

